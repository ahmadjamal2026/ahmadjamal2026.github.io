  "text": {
    "ar": {
      "name": "أحمد جمال",
      "sub": "هويات بصرية، سوشيال ميديا، وإعلانات للشركات والعيادات والمطاعم والبراندات. تصاميم تخلّي الناس توقف، تشوف… وتشتري.",
      "charge": "التهمة: تصاميم توقّف السكرول",
      "newsHead": "عاجل: تصاميم توقّف السكرول… والمتّهم من القاهرة",
      "sticky": "كل الأدلة تشير إلى أحمد!",
      "aboutShort": "متخصص في الهوية البصرية والتصميم الرقمي، وأصمّم لـ Jameia.com منذ أبريل 2024. هدفي أن يخدم كل تصميم هدفاً تسويقياً حقيقياً، لا أن يكون جميلاً فقط.",
      "leadA": "مصمم جرافيك يهتم",
      "leadB": "بالتفاصيل الصغيرة اللي تصنع الفرق.",
      "bio": "متخصص في الهوية البصرية والتصميم الرقمي. أشتغل على Photoshop وIllustrator، وأستخدم أدوات الذكاء الاصطناعي لأوصل لأفكار أسرع وجودة أعلى. هدفي أن يخدم كل تصميم هدفاً تسويقياً حقيقياً، لا أن يكون جميلاً فقط.",
      "workSub": "مشاريع حقيقية لعملاء حقيقيين. اختر النوع، وافتح أي مشروع وقلّب صوره.",
      "jmIntro": "أصمّم لـ Jameia.com منذ أبريل 2024 عن بُعد: بوستات وستوري السوشيال ميديا، وبانرات و POP-up التطبيق.",
      "ctSub": "ابعت لي فكرتك على واتساب، وخلّينا نبدأ."
    },
    "en": {
      "name": "Ahmad Jamal",
      "sub": "Brand identities, social media and ads for companies, clinics, restaurants and brands. Designs that make people stop, look… and buy.",
      "charge": "Charge: designs that stop the scroll",
      "newsHead": "Breaking: designs that stop the scroll — suspect is from Cairo",
      "sticky": "All evidence points to Ahmad!",
      "aboutShort": "I specialise in brand identity and digital design, and have designed for Jameia.com since April 2024. Every design should serve a real marketing goal, not just look good.",
      "leadA": "A graphic designer obsessed with",
      "leadB": "the small details that make the difference.",
      "bio": "I specialise in brand identity and digital design. I work in Photoshop and Illustrator, and use AI tools to reach ideas faster and push quality higher. My goal: every design should serve a real marketing goal — not just look good.",
      "workSub": "Real projects for real clients. Pick a type, then open any project to browse it.",
      "jmIntro": "Designing for Jameia.com remotely since April 2024: social media content, plus banners and pop-ups for the app.",
      "ctSub": "Send me your idea on WhatsApp and let’s get started."
    }
  },
